<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/etExisting"
        android:hint="@string/textExistingPassword"
        android:singleLine="true"
        android:lines="1"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/etExisting"
        android:id="@+id/etChange"
        android:singleLine="true"
        android:lines="1"
        android:hint="@string/textPasswordToChange"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/etChange"
        android:id="@+id/etConfirmChange"
        android:singleLine="true"
        android:lines="1"
        android:hint="@string/textCheckedPasswordToChange"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>

</RelativeLayout>