<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rlRoot">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/textPleaseEnterTheOtherPersonIdToSharing"
        android:textSize="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:textColor="@color/black"
        android:id="@+id/tvTitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@+id/tvTitle"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:id="@+id/llTop">
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/textID"
            android:singleLine="true"
            android:lines="1"
            android:id="@+id/etId" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10dp"
        android:layout_below="@id/llTop"
        android:id="@+id/tvSharing"
        android:layout_marginLeft="20dp"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/textSetShare"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/llTop"
        android:layout_marginTop="30dp"
        android:background="@color/ocbg"
        android:textColor="@color/white"
        android:id="@+id/btnSuccess"/>

    <ListView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/listView1"
        android:padding="20dp"
        android:layout_below="@+id/btnSuccess"
        android:layout_gravity="center_vertical" />
    <ListView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:id="@+id/list"
        android:translationZ="30dp"
        android:layout_below="@id/llTop"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="70dp"
        android:listSelector="#aaaaaa"
        android:divider="#eeeeee"
        android:background="#eeeeee"
        android:visibility="gone"/>
</RelativeLayout>