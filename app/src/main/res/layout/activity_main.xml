<?xml version="1.0" encoding="utf-8"?>

<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:id="@+id/swipe_layout"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/rlRoot"
        android:clipChildren="false"
    android:background="@drawable/blue_skies">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:popupTheme="@style/AppTheme.PopupOverlay" />

    <com.skyfishjy.library.RippleBackground
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/content"
        app:rb_color="#99999999"
        app:rb_type="fillRipple"
        app:rb_radius="180dp"
        app:rb_rippleAmount="3"
        app:rb_duration="20000"
        app:rb_scale="6">
        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:id="@+id/centerImage" />
    </com.skyfishjy.library.RippleBackground>

        <RelativeLayout
            android:id="@+id/rlWindVelocity"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:background="@drawable/rounded"
            android:layout_below="@id/toolbar"
            android:layout_marginRight="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="20dp"
            >

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rlRootProgressBar"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="35dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/horizontal_recycler_view"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_below="@id/rlRootProgressBar">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="50dp"
                    android:layout_marginRight="50dp"
                    android:background="@color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="50dp"
                    android:textSize="18dp"
                    android:text="최대 풍속 \n12 : 34"
                    android:id="@+id/tv_max"
                    android:textColor="@color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="50dp"
                    android:text="11.6m/s"
                    android:textSize="30dp"
                    android:textStyle="bold"
                    android:id="@+id/tv_wind_velocity_max"
                    android:layout_toRightOf="@+id/tv_max"
                    android:textColor="@color/white" />

            </RelativeLayout>



            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/rlRootProgressBar"
                android:layout_alignBaseline="@+id/rlRootProgressBar"
                android:layout_marginTop="20dp">

                <RelativeLayout
                    android:id="@+id/mid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">


                    <TextView
                        android:id="@+id/tvWindVelocity1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_moment_wind_velocity"
                        android:textColor="@color/textGray"
                        android:textSize="25dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWindVelocityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/tvWindVelocity1"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="28dp" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/tvWindTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/mid"
                    android:layout_centerHorizontal="true"
                    android:text="@string/Wind"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWindSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvWindTitle"
                    android:layout_centerHorizontal="true"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/Explanation"
                    android:textColor="@color/white"
                    android:textSize="18dp" />
            </RelativeLayout>
        </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rlWindVelocity"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/rounded">

        <LinearLayout
            android:id="@+id/llmid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/rlAtmRoot"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/rlAtmosphere"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="30dp"
                    android:paddingRight="30dp"
                    android:layout_centerVertical="true">

                    <RelativeLayout
                        android:id="@+id/rlHumidity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_weight="1">

                        <RelativeLayout
                            android:id="@+id/rlH"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true">

                            <ImageView
                                android:id="@+id/ivHumidity"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/ic_humidity_half" />

                            <TextView
                                android:id="@+id/tvHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toRightOf="@+id/ivHumidity"
                                android:text="@string/textHum"
                                android:textColor="@color/white" />
                        </RelativeLayout>


                        <TextView
                            android:id="@+id/tvHumidityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/rlH"
                            android:layout_centerHorizontal="true"
                            android:text="0 %"
                            android:textColor="@color/white"
                            android:textSize="17dp" />
                    </RelativeLayout>


                    <RelativeLayout
                        android:id="@+id/rlAtm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_toRightOf="@+id/tvCenter"
                        android:layout_weight="1">

                        <RelativeLayout
                            android:id="@+id/rlA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true">

                            <ImageView
                                android:id="@+id/ivAtm"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/ic_atmosphere" />

                            <TextView
                                android:id="@+id/tvAtm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_centerVertical="true"
                                android:layout_toRightOf="@+id/ivAtm"
                                android:text="@string/text_wind_atom"
                                android:textColor="@color/white" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tvAtmValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/rlA"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="20dp"
                            android:text="0 hPa "
                            android:textColor="@color/white"
                            android:textSize="17dp" />
                    </RelativeLayout>

                </LinearLayout>
            </RelativeLayout>



            <RelativeLayout
                android:id="@+id/rlMidWindDirection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">

                    <ImageView
                        android:id="@+id/ivWindDirection"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/ic_wind_direction" />

                    <TextView
                        android:id="@+id/tvWindDirection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_toRightOf="@+id/ivWindDirection"
                        android:text="@string/text_wind_direction"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlWindDirection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">


                    <net.ijoon.ijoonweatherstation.compass.ChaosCompassView
                        android:id="@+id/ccv"
                        android:layout_width="111dp"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="20dp"
                        android:background="#00ffffff" />
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/llmid"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:background="@color/white" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/llmid"
            android:id="@+id/rlWind">

            <RelativeLayout
                android:id="@+id/rlWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">

                <ImageView
                    android:id="@+id/ivWeather"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/ic_cloud" />

                <TextView
                    android:id="@+id/tvTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@+id/ivWeather"
                    android:text="0℃"
                    android:textColor="@color/white"
                    android:textSize="30dp" />

            </RelativeLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rlWeather"
                android:text="@string/midle_title"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="15dp"
                android:lines="3"
                android:layout_marginBottom="10dp"
                android:layout_centerHorizontal="true"
                android:id="@+id/tvWeather"/>
        </RelativeLayout>

    </RelativeLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textColor="@color/white"
        android:text="ver"
        android:id="@+id/tvVersion"
        android:layout_below="@id/rlBottom"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/rl"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>
    </RelativeLayout>
    </ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>