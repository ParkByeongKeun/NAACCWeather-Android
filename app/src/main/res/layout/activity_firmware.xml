<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">


        <TextView
            android:id="@+id/tvUpdateVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_above="@+id/tvCurrentVersion"
            android:layout_marginBottom="10dp"
            android:layout_centerHorizontal="true"
            android:text="@string/textLoadingLatestVersion"
            android:textColor="#000000"
            android:textSize="25dp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/tvLatestVersion"

            android:textSize="15dp"
            android:layout_centerHorizontal="true"
            android:id="@+id/tvCurrentVersion"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:id="@+id/tvLatestVersion"

            android:textSize="15dp" />

        <Button
            android:id="@+id/btnVersionUpdate"
            android:layout_width="281dp"
            android:layout_height="25dp"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/tvLatestVersion"

            android:layout_marginStart="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="11dp"
            android:layout_marginEnd="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/gray_rounded"
            android:text= "@string/textUpdateToTheLatestVersion" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/btnVersionUpdate"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:textSize="10dp"
            android:id="@+id/tvDownloadText"/>
    
</RelativeLayout>