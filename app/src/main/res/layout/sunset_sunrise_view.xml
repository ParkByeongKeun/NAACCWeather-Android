<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/more_information"
        android:textSize="17dp"
        android:textStyle="bold"
        android:layout_marginLeft="20dp"
        android:textColor="#000000"
        android:id="@+id/tvTop"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#cccccc"
        android:id="@+id/tvLine"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/tvTop"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/tvLine"
        android:id="@+id/rlMid"
        android:layout_marginTop="15dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_sunrise"
            android:layout_centerVertical="true"
            android:layout_marginLeft="50dp"
            android:id="@+id/ivSunrise"/>

        <TextView
            android:id="@+id/tvSunrise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_toRightOf="@+id/ivSunrise"
            android:layout_marginLeft="20dp"
            android:layout_centerVertical="true"
            android:text="@string/sunrise" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:layout_marginRight="50dp"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:id="@+id/tvTime"/>
    </RelativeLayout>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#cccccc"
        android:id="@+id/tvLine2"
        android:layout_below="@+id/rlMid"/>




    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/tvLine2"
        android:id="@+id/rlBottom"
        android:layout_marginTop="15dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_sunset"
            android:layout_centerVertical="true"
            android:layout_marginLeft="50dp"
            android:id="@+id/ivSunset"/>

        <TextView
            android:id="@+id/tvSunset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_toRightOf="@+id/ivSunset"
            android:layout_marginLeft="20dp"
            android:layout_centerVertical="true"
            android:text="@string/sunset" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:layout_marginRight="50dp"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:id="@+id/tvTimeSunset"/>
    </RelativeLayout>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#cccccc"
        android:id="@+id/tvLine5"
        android:layout_below="@+id/rlBottom"/>

</RelativeLayout>